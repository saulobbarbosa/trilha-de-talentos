# =====================================================================
# Trilha de Talentos - configuracao local
# Copie para .env (o setup.bat faz isso e gera a SECRET_KEY).
# =====================================================================

# --- Aplicacao ---
APP_NAME=Trilha de Talentos
DEV_MODE=true
# Gere uma chave aleatoria: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA
DATABASE_URL=sqlite:///./data/app.db

# --- Servidor / acesso pelo celular ---
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=43200

# Se preencher, sera usado no QR Code dos certificados.
# Ex.: http://192.168.0.10:8000
PUBLIC_BASE_URL=

# --- HTTPS local (opcional, necessario para getUserMedia ao vivo) ---
USE_HTTPS=false
HTTPS_CERT_FILE=data/certs/lins-local.crt
HTTPS_KEY_FILE=data/certs/lins-local.key

# --- Reconhecimento facial (similaridade de cosseno) ---
FACE_THRESHOLD=0.45
# Diferenca minima entre o 1o e o 2o candidato para evitar ambiguidade
FACE_MARGIN=0.05
FACE_MODEL_ROOT=data/insightface
# Carrega o modelo buffalo_l na inicializacao usando CPU.
FACE_MODEL_PRELOAD=true
FACE_DET_SIZE=640
# Cadastro guiado: quantidade de capturas e consistencia minima entre elas.
FACE_ENROLL_SAMPLES=3
FACE_ENROLL_MIN_SIMILARITY=0.30
FACE_MIN_DET_SCORE=0.65
FACE_MIN_FACE_PIXELS=120
FACE_MAX_IMAGE_PIXELS=20000000
MAX_UPLOAD_MB=8

# --- Limite de tentativas de login ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# --- SMTP real (opcional; vazio = outbox de desenvolvimento) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@lins.local
SMTP_USE_TLS=true
